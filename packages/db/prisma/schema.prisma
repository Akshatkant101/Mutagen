datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

model User {
  id           String        @id @default(uuid())
  username     String
  email        String?       @unique
  createdAt    DateTime      @default(now())
  matchPlayers MatchPlayer[]
}

model Match {
  id            String        @id @default(uuid())
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  result        String?
  bossVersionId String
  bossVersion   BossVersion   @relation(fields: [bossVersionId], references: [id])
  matchPlayers  MatchPlayer[]
  events        BattleEvent[]
}

model MatchPlayer {
  id          String   @id @default(uuid())
  userId      String
  matchId     String
  damageDealt Float    @default(0)
  deaths      Int      @default(0)
  survivalSec Float    @default(0)
  user        User     @relation(fields: [userId], references: [id])
  match       Match    @relation(fields: [matchId], references: [id])
}

model BossVersion {
  id        String   @id @default(uuid())
  version   Int      @unique
  config    Json
  changes   String
  createdAt DateTime @default(now())
  matches   Match[]
}

model BattleEvent {
  id      String @id @default(uuid())
  matchId String
  type    String
  tMs     Int
  payload Json
  match   Match  @relation(fields: [matchId], references: [id])

  @@index([matchId, type])
}
